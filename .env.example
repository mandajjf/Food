# 必填：Flask session 加密金鑰
# 本機開發可隨意填入，正式環境請使用隨機長字串
SECRET_KEY=your-random-secret-key-here

# 資料庫連線（本機開發可留空，會自動使用 SQLite）
# Render 部署時請設定為 PostgreSQL internal database URL
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# 可選：Flask 執行模式（development / production）
FLASK_ENV=development

# 可選：Google Maps API 金鑰（未來整合 Maps 功能時使用）
# GOOGLE_MAPS_API_KEY=your-api-key-here
